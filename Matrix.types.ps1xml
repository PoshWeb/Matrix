                "&lt;mtd&gt;&lt;mn&gt;$($this."M${row}${col}")&lt;/mn&gt;&lt;/mtd&gt;"
            }
            "&lt;/mtr&gt;"
        }
    )
    &lt;/mtable&gt;
    &lt;mo&gt;]&lt;/mo&gt;
    &lt;mo&gt;=&lt;/mo&gt;$(
        [Numerics.Matrix4x4]::Create($this).MathML.math.innerXml
    )  
&lt;/math&gt;
"@

                    </GetScriptBlock>
